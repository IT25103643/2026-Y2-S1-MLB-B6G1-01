    "\"\"\"\n",
    "Step 6 — Feature Selection & Dimensionality Reduction\n",
    "\n",
    "Inputs : ../Feature Engineering (Text Vectorization)/movies_reviews_train_tfidf.csv\n",
    "         ../Feature Engineering (Text Vectorization)/movies_reviews_test_tfidf.csv\n",
    "Outputs: movies_reviews_train_final.csv\n",
    "         movies_reviews_test_final.csv\n",
    "Chart  : step6_svd_scatter_by_sentiment.png\n",
    "\"\"\"\n",
    "\n",
    "# ── Standard library ──────────────────────────────────────────────────────────\n",
    "import sys\n",
    "\n",
    "# ── Third-party ───────────────────────────────────────────────────────────────\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from sklearn.decomposition import TruncatedSVD\n",
    "from sklearn.feature_selection import SelectKBest, chi2\n",
    "\n",
    "# ── Font for nicer charts (falls back silently if unavailable) ────────────────\n",
    "plt.rcParams[\"font.family\"] = \"DejaVu Sans\"\n",
    "\n",
    "# ==============================================================================\n",
    "# CONFIG  —  Paths relative to the 'Feature Selection & Dimensionality Reduction' dir\n",
    "# ==============================================================================\n",
    "TRAIN_INPUT_FILE  = \"../Feature Engineering (Text Vectorization)/movies_reviews_train_tfidf.csv\"\n",
    "TEST_INPUT_FILE   = \"../Feature Engineering (Text Vectorization)/movies_reviews_test_tfidf.csv\"\n",
    "TRAIN_OUTPUT_FILE = \"movies_reviews_train_final.csv\"\n",
    "TEST_OUTPUT_FILE  = \"movies_reviews_test_final.csv\"\n",
    "CHART_FILE        = \"step6_svd_scatter_by_sentiment.png\"\n",
    "\n",
    "# SelectKBest: how many TF-IDF features to keep\n",
    "K_BEST = 500\n",
    "\n",
    "# SVD n_components for the 2D visualisation (visualisation only — NOT exported)\n",
    "SVD_COMPONENTS = 2\n",
    "\n",
    "# Sentiment thresholds based on Ratings (out of 10)\n",
    "POSITIVE_THRESHOLD = 7.0   # Ratings >= this => Positive\n",
    "NEGATIVE_THRESHOLD = 5.0   # Ratings <  this => Negative  (between => Neutral)\n",
    "\n",
    "print(\"=\" * 70)\n",
    "print(\"STEP 6: Feature Selection & Dimensionality Reduction\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "try:\n",
    "    df_train = pd.read_csv(TRAIN_INPUT_FILE)\n",
    "    df_test  = pd.read_csv(TEST_INPUT_FILE)\n",
    "except FileNotFoundError as e:\n",
    "    print(f\"\\n[Error] {e}\")\n",
    "    print(\"Make sure you have run Step 5 first!\")\n",
    "    sys.exit(1)\n",
    "\n",
    "print(f\"\\n[Load]  Train: {len(df_train):,} rows x {len(df_train.columns)} cols\")\n",
    "print(f\"[Load]  Test : {len(df_test):,} rows x {len(df_test.columns)} cols\")\n",
    "\n",
    "# Separate the concatenated column groups from Step 5 output.\n",
    "\n",
    "tfidf_cols = [c for c in df_train.columns if c.startswith(\"tfidf_\")]\n",
    "\n",
    "genre_cols   = [c for c in df_train.columns if c.startswith(\"genre_\")]\n",
    "emotion_cols = [c for c in df_train.columns if c.startswith(\"emotion_\")]\n",
    "cat_cols     = genre_cols + emotion_cols\n",
    "\n",
    "target_col = \"Ratings\"\n",
    "\n",
    "meta_cols = [c for c in [\"movie_name\", \"review_length\"] if c in df_train.columns]\n",
    "\n",
    "print(f\"\\n[Columns] TF-IDF features : {len(tfidf_cols)}\")\n",
    "print(f\"[Columns] Genre features  : {len(genre_cols)}\")\n",
    "print(f\"[Columns] Emotion features: {len(emotion_cols)}\")\n",
    "print(f\"[Columns] Metadata        : {meta_cols}\")\n",
    "\n",
    "X_train_tfidf = df_train[tfidf_cols]\n",
    "X_test_tfidf  = df_test[tfidf_cols]\n",
    "\n",
    "y_train = df_train[target_col]\n",
    "y_test  = df_test[target_col]\n",
    "\n",
    "# chi2 measures statistical association between each term and Ratings.\n",
    "# It requires non-negative input, which TF-IDF always satisfies (values >= 0).\n",
    "print(f\"\\n[Select] Applying SelectKBest (chi2) to keep top {K_BEST} TF-IDF features...\")\n",
    "print(f\"         Fitting ONLY on training data...\")\n",
    "\n",
    "X_train_tfidf_clean = X_train_tfidf.fillna(0)\n",
    "X_test_tfidf_clean  = X_test_tfidf.fillna(0)\n",
    "\n",
    "train_valid_mask = y_train.notna()\n",
    "X_fit = X_train_tfidf_clean[train_valid_mask]\n",
    "y_fit = y_train[train_valid_mask]\n",
    "\n",
    "selector = SelectKBest(chi2, k=K_BEST)\n",
    "selector.fit(X_fit, y_fit)\n",
    "\n",
    "X_train_selected = selector.transform(X_train_tfidf_clean)\n",
    "X_test_selected  = selector.transform(X_test_tfidf_clean)\n",
    "\n",
    "selected_feature_names = np.array(tfidf_cols)[selector.get_support()]\n",
    "\n",
    "print(f\"[Select] Retained {K_BEST} features from {len(tfidf_cols)} TF-IDF columns.\")\n",
    "\n",
    "scores = selector.scores_\n",
    "top10_idx = np.argsort(scores)[::-1][:10]\n",
    "print(f\"\\n[Select] Top 10 features by chi2 score:\")\n",
    "for i in top10_idx:\n",
    "    clean_name = tfidf_cols[i].replace(\"tfidf_\", \"\")\n",
    "    print(f\"         {clean_name:<30} chi2 = {scores[i]:.2f}\")\n",
    "\n",
    "# TruncatedSVD projects the high-dimensional TF-IDF space to 2D for plotting.\n",
    "# PCA is avoided here because it centers the data first, which destroys TF-IDF\n",
    "# sparsity and causes excessive memory use. TruncatedSVD skips centering.\n",
    "print(f\"\\n[SVD]   Fitting TruncatedSVD ({SVD_COMPONENTS} components) on training data...\")\n",
    "\n",
    "svd = TruncatedSVD(n_components=SVD_COMPONENTS, random_state=42)\n",
    "X_train_2d = svd.fit_transform(X_train_selected)\n",
    "\n",
    "X_test_2d = svd.transform(X_test_selected)\n",
    "\n",
    "explained_var = svd.explained_variance_ratio_\n",
    "print(f\"[SVD]   Explained Variance Ratio per component:\")\n",
    "for i, ev in enumerate(explained_var):\n",
    "    print(f\"         Component {i+1}: {ev * 100:.2f}%\")\n",
    "print(f\"[SVD]   Total Explained Variance: {sum(explained_var) * 100:.2f}%\")\n",
    "print(f\"         (Note: Low variance from 2 components is expected for high-dim text data.)\")\n",
    "\n",
    "# Define sentiment class from Ratings\n",
    "def get_sentiment(rating):\n",
    "    \"\"\"Bucket Ratings into 3 sentiment categories.\"\"\"\n",
    "    if pd.isna(rating):\n",
    "        return \"Unknown\"\n",
    "    if rating >= POSITIVE_THRESHOLD:\n",
    "        return \"Positive\"\n",
    "    elif rating < NEGATIVE_THRESHOLD:\n",
    "        return \"Negative\"\n",
    "    else:\n",
    "        return \"Neutral\"\n",
    "\n",
    "y_train_all = df_train[target_col]\n",
    "sentiments  = y_train_all.apply(get_sentiment)\n",
    "\n",
    "print(f\"\\n[EDA]   Generating 2D SVD scatter plot by sentiment...\")\n",
    "\n",
    "sentiment_colors = {\n",
    "    \"Positive\": \"#4C9BE8\",  # blue\n",
    "    \"Neutral\":  \"#F0C040\",  # yellow\n",
    "    \"Negative\": \"#E07B54\",  # orange-red\n",
    "    \"Unknown\":  \"#AAAAAA\",  # grey\n",
    "}\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(11, 8))\n",
    "\n",
    "for sentiment, color in sentiment_colors.items():\n",
    "    mask = sentiments == sentiment\n",
    "    if mask.sum() == 0:\n",
    "        continue\n",
    "    ax.scatter(\n",
    "        X_train_2d[mask, 0],\n",
    "        X_train_2d[mask, 1],\n",
    "        label=f\"{sentiment} ({mask.sum():,})\",\n",
    "        color=color,\n",
    "        alpha=0.35,\n",
    "        s=8,\n",
    "        edgecolors='none'\n",
    "    )\n",
    "\n",
    "ax.set_title(\n",
    "    f\"Step 6 — TruncatedSVD 2D Projection of TF-IDF Features\\n\"\n",
    "    f\"(Training data, colored by Sentiment class)\\n\"\n",
    "    f\"Explained Variance: {sum(explained_var) * 100:.1f}%\",\n",
    "    fontsize=13, fontweight=\"bold\"\n",
    ")\n",
    "ax.set_xlabel(\"SVD Component 1\", fontsize=11)\n",
    "ax.set_ylabel(\"SVD Component 2\", fontsize=11)\n",
    "ax.legend(title=\"Sentiment\", fontsize=10, title_fontsize=10, markerscale=3)\n",
    "ax.spines[[\"top\", \"right\"]].set_visible(False)\n",
    "ax.grid(linestyle=\"--\", alpha=0.4)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(CHART_FILE, dpi=150, bbox_inches=\"tight\")\n",
    "plt.close()\n",
    "print(f\"[Chart] Saved -> {CHART_FILE}\")\n",
    "\n",
    "# Export uses SelectKBest-selected features (not the 2D SVD output, which is\n",
    "# for visualization only and too lossy for actual modeling).\n",
    "\n",
    "def build_final_df(selected_array, feature_names, original_df, cat_cols, target_col, meta_cols):\n",
    "    \"\"\"Assembles the final DataFrame ready for modeling.\"\"\"\n",
    "    tfidf_df = pd.DataFrame(\n",
    "        selected_array,\n",
    "        columns=feature_names,\n",
    "        index=original_df.index\n",
    "    )\n",
    "    other_df = original_df[cat_cols + [target_col] + meta_cols].copy()\n",
    "    \n",
    "    return pd.concat([other_df, tfidf_df], axis=1)\n",
    "\n",
    "print(f\"\\n[Build] Assembling final datasets ({K_BEST} TF-IDF + categorical + target)...\")\n",
    "\n",
    "train_final = build_final_df(X_train_selected, selected_feature_names,\n",
    "                              df_train, cat_cols, target_col, meta_cols)\n",
    "test_final  = build_final_df(X_test_selected,  selected_feature_names,\n",
    "                              df_test,  cat_cols, target_col, meta_cols)\n",
    "\n",
    "train_final.to_csv(TRAIN_OUTPUT_FILE, index=False)\n",
    "print(f\"[Export] Saved Train -> {TRAIN_OUTPUT_FILE} ({len(train_final):,} rows, {len(train_final.columns)} cols)\")\n",
    "\n",
    "test_final.to_csv(TEST_OUTPUT_FILE, index=False)\n",
    "print(f\"[Export] Saved Test  -> {TEST_OUTPUT_FILE} ({len(test_final):,} rows, {len(test_final.columns)} cols)\")\n",
    "\n",
    "print(\"\\n[Done]  Step 6 complete.\")\n",
    "print(\"        The final modeling-ready datasets are ready for downstream ML models.\\n\")\n"
   ],
