      "cell_type": "code",
      "source": "\"\"\"\nStep 6 — Feature Selection & Dimensionality Reduction\n\nInputs : movies_reviews_train_tfidf.csv\n         movies_reviews_test_tfidf.csv\nOutputs: movies_reviews_train_final.csv\n         movies_reviews_test_final.csv\nChart  : step6_svd_scatter_by_sentiment.png\n\"\"\"\n\n# ── Standard library ──────────────────────────────────────────────────────────\nimport sys\n\n# ── Third-party ───────────────────────────────────────────────────────────────\nimport matplotlib.pyplot as plt\nimport numpy as np\nimport pandas as pd\nfrom sklearn.decomposition import TruncatedSVD\nfrom sklearn.feature_selection import SelectKBest, chi2\n\n# ── Font for nicer charts (falls back silently if unavailable) ────────────────\nplt.rcParams[\"font.family\"] = \"DejaVu Sans\"\n\n# ==============================================================================\n# CONFIG  —  Paths updated to look in the current folder\n# ==============================================================================\nTRAIN_INPUT_FILE  = \"movies_reviews_train_tfidf.csv\"\nTEST_INPUT_FILE   = \"movies_reviews_test_tfidf.csv\"\nTRAIN_OUTPUT_FILE = \"movies_reviews_train_final.csv\"\nTEST_OUTPUT_FILE  = \"movies_reviews_test_final.csv\"\nCHART_FILE        = \"step6_svd_scatter_by_sentiment.png\"\n\n# SelectKBest: how many TF-IDF features to keep\nK_BEST = 500\n\n# SVD n_components for the 2D visualisation (visualisation only — NOT exported)\nSVD_COMPONENTS = 2\n\n# Sentiment thresholds based on Ratings (out of 10)\nPOSITIVE_THRESHOLD = 7.0   # Ratings >= this => Positive\nNEGATIVE_THRESHOLD = 5.0   # Ratings <  this => Negative  (between => Neutral)\n\nprint(\"=\" * 70)\nprint(\"STEP 6: Feature Selection & Dimensionality Reduction\")\nprint(\"=\" * 70)\n\ntry:\n    df_train = pd.read_csv(TRAIN_INPUT_FILE)\n    df_test  = pd.read_csv(TEST_INPUT_FILE)\nexcept FileNotFoundError as e:\n    print(f\"\\n[Error] {e}\")\n    print(\"Make sure you have run Step 5 first!\")\n    sys.exit(1)\n\nprint(f\"\\n[Load]  Train: {len(df_train):,} rows x {len(df_train.columns)} cols\")\nprint(f\"[Load]  Test : {len(df_test):,} rows x {len(df_test.columns)} cols\")\n\n# Separate the concatenated column groups from Step 5 output.\ntfidf_cols = [c for c in df_train.columns if c.startswith(\"tfidf_\")]\n\ngenre_cols   = [c for c in df_train.columns if c.startswith(\"genre_\")]\nemotion_cols = [c for c in df_train.columns if c.startswith(\"emotion_\")]\ncat_cols     = genre_cols + emotion_cols\n\ntarget_col = \"Ratings\"\n\nmeta_cols = [c for c in [\"movie_name\", \"review_length\"] if c in df_train.columns]\n\nprint(f\"\\n[Columns] TF-IDF features : {len(tfidf_cols)}\")\nprint(f\"[Columns] Genre features  : {len(genre_cols)}\")\nprint(f\"[Columns] Emotion features: {len(emotion_cols)}\")\nprint(f\"[Columns] Metadata        : {meta_cols}\")\n\nX_train_tfidf = df_train[tfidf_cols]\nX_test_tfidf  = df_test[tfidf_cols]\n\ny_train = df_train[target_col]\ny_test  = df_test[target_col]\n\n# chi2 measures statistical association between each term and Ratings.\n# It requires non-negative input, which TF-IDF always satisfies (values >= 0).\nprint(f\"\\n[Select] Applying SelectKBest (chi2) to keep top {K_BEST} TF-IDF features...\")\nprint(f\"         Fitting ONLY on training data...\")\n\nX_train_tfidf_clean = X_train_tfidf.fillna(0)\nX_test_tfidf_clean  = X_test_tfidf.fillna(0)\n\ntrain_valid_mask = y_train.notna()\nX_fit = X_train_tfidf_clean[train_valid_mask]\ny_fit = y_train[train_valid_mask]\n\nselector = SelectKBest(chi2, k=K_BEST)\nselector.fit(X_fit, y_fit)\n\nX_train_selected = selector.transform(X_train_tfidf_clean)\nX_test_selected  = selector.transform(X_test_tfidf_clean)\n\nselected_feature_names = np.array(tfidf_cols)[selector.get_support()]\n\nprint(f\"[Select] Retained {K_BEST} features from {len(tfidf_cols)} TF-IDF columns.\")\n\nscores = selector.scores_\ntop10_idx = np.argsort(scores)[::-1][:10]\nprint(f\"\\n[Select] Top 10 features by chi2 score:\")\nfor i in top10_idx:\n    clean_name = tfidf_cols[i].replace(\"tfidf_\", \"\")\n    print(f\"         {clean_name:<30} chi2 = {scores[i]:.2f}\")\n\n# TruncatedSVD projects the high-dimensional TF-IDF space to 2D for plotting.\n# PCA is avoided here because it centers the data first, which destroys TF-IDF\n# sparsity and causes excessive memory use. TruncatedSVD skips centering.\nprint(f\"\\n[SVD]   Fitting TruncatedSVD ({SVD_COMPONENTS} components) on training data...\")\n\nsvd = TruncatedSVD(n_components=SVD_COMPONENTS, random_state=42)\nX_train_2d = svd.fit_transform(X_train_selected)\n\nX_test_2d = svd.transform(X_test_selected)\n\nexplained_var = svd.explained_variance_ratio_\nprint(f\"[SVD]   Explained Variance Ratio per component:\")\nfor i, ev in enumerate(explained_var):\n    print(f\"         Component {i+1}: {ev * 100:.2f}%\")\nprint(f\"[SVD]   Total Explained Variance: {sum(explained_var) * 100:.2f}%\")\nprint(f\"         (Note: Low variance from 2 components is expected for high-dim text data.)\")\n\n# Define sentiment class from Ratings\ndef get_sentiment(rating):\n    \"\"\"Bucket Ratings into 3 sentiment categories.\"\"\"\n    if pd.isna(rating):\n        return \"Unknown\"\n    if rating >= POSITIVE_THRESHOLD:\n        return \"Positive\"\n    elif rating < NEGATIVE_THRESHOLD:\n        return \"Negative\"\n    else:\n        return \"Neutral\"\n\ny_train_all = df_train[target_col]\nsentiments  = y_train_all.apply(get_sentiment)\n\nprint(f\"\\n[EDA]   Generating 2D SVD scatter plot by sentiment...\")\n\nsentiment_colors = {\n    \"Positive\": \"#4C9BE8\",  # blue\n    \"Neutral\":  \"#F0C040\",  # yellow\n    \"Negative\": \"#E07B54\",  # orange-red\n    \"Unknown\":  \"#AAAAAA\",  # grey\n}\n\nfig, ax = plt.subplots(figsize=(11, 8))\n\nfor sentiment, color in sentiment_colors.items():\n    mask = sentiments == sentiment\n    if mask.sum() == 0:\n        continue\n    ax.scatter(\n        X_train_2d[mask, 0],\n        X_train_2d[mask, 1],\n        label=f\"{sentiment} ({mask.sum():,})\",\n        color=color,\n        alpha=0.35,\n        s=8,\n        edgecolors='none'\n    )\n\nax.set_title(\n    f\"Step 6 — TruncatedSVD 2D Projection of TF-IDF Features\\n\"\n    f\"(Training data, colored by Sentiment class)\\n\"\n    f\"Explained Variance: {sum(explained_var) * 100:.1f}%\",\n    fontsize=13, fontweight=\"bold\"\n)\nax.set_xlabel(\"SVD Component 1\", fontsize=11)\nax.set_ylabel(\"SVD Component 2\", fontsize=11)\nax.legend(title=\"Sentiment\", fontsize=10, title_fontsize=10, markerscale=3)\nax.spines[[\"top\", \"right\"]].set_visible(False)\nax.grid(linestyle=\"--\", alpha=0.4)\n\nplt.tight_layout()\nplt.savefig(CHART_FILE, dpi=150, bbox_inches=\"tight\")\nplt.close()\nprint(f\"[Chart] Saved -> {CHART_FILE}\")\n\n# Export uses SelectKBest-selected features (not the 2D SVD output, which is\n# for visualization only and too lossy for actual modeling).\n\ndef build_final_df(selected_array, feature_names, original_df, cat_cols, target_col, meta_cols):\n    \"\"\"Assembles the final DataFrame ready for modeling.\"\"\"\n    tfidf_df = pd.DataFrame(\n        selected_array,\n        columns=feature_names,\n        index=original_df.index\n    )\n    other_df = original_df[cat_cols + [target_col] + meta_cols].copy()\n    \n    return pd.concat([other_df, tfidf_df], axis=1)\n\nprint(f\"\\n[Build] Assembling final datasets ({K_BEST} TF-IDF + categorical + target)...\")\n\ntrain_final = build_final_df(X_train_selected, selected_feature_names,\n                              df_train, cat_cols, target_col, meta_cols)\ntest_final  = build_final_df(X_test_selected,  selected_feature_names,\n                              df_test,  cat_cols, target_col, meta_cols)\n\ntrain_final.to_csv(TRAIN_OUTPUT_FILE, index=False)\nprint(f\"[Export] Saved Train -> {TRAIN_OUTPUT_FILE} ({len(train_final):,} rows, {len(train_final.columns)} cols)\")\n\ntest_final.to_csv(TEST_OUTPUT_FILE, index=False)\nprint(f\"[Export] Saved Test  -> {TEST_OUTPUT_FILE} ({len(test_final):,} rows, {len(test_final.columns)} cols)\")\n\nprint(\"\\n[Done]  Step 6 complete.\")\nprint(\"        The final modeling-ready datasets are ready for downstream ML models.\\n\")",
